# Copy this file to .env.local and fill in your actual values.
# .env.local is gitignored and never committed.

# From Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From Supabase Project Settings > API (service_role key — KEEP SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for /admin login (choose your own strong password)
ADMIN_PASSWORD=choose-a-strong-password

# Optional: a separate secret for signing the admin session cookie.
# If not set, ADMIN_PASSWORD is used for this too.
ADMIN_SESSION_SECRET=choose-a-random-secret-string

# Optional: contact-form email via Resend (https://resend.com). If unset, the
# form still saves to the inquiries table — it just skips sending email.
RESEND_API_KEY=your-resend-api-key
# Verified sender address in Resend (defaults to "KhaliPlot <hello@khaliplot.in>").
CONTACT_FROM_EMAIL=KhaliPlot <hello@khaliplot.in>
# Optional: internal inbox that gets notified of each new inquiry/report.
CONTACT_NOTIFY_EMAIL=team@khaliplot.in
