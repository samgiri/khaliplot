# Copy this file to .env.local and fill in your actual values.
# .env.local is gitignored and never committed.

# From Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From Supabase Project Settings > API (service_role key — KEEP SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for /admin login (choose your own strong password)
ADMIN_PASSWORD=choose-a-strong-password

# Optional: a separate secret for signing the admin session cookie.
# If not set, ADMIN_PASSWORD is used for this too.
ADMIN_SESSION_SECRET=choose-a-random-secret-string
